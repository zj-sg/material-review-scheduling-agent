# Copy to .env. Existing deterministic commands work without model credentials.
MATERIAL_AGENT_TIMEZONE=Asia/Shanghai
MATERIAL_AGENT_DATABASE_PATH=data/drafts.sqlite3
MATERIAL_AGENT_EXAMPLES_DIR=examples
MATERIAL_AGENT_API_DATA_PATH=data/api-data.json
MATERIAL_AGENT_API_OFFLINE=false
MATERIAL_AGENT_MAX_MODEL_CALLS=12

# For agent-example: uncomment and fill all three values locally.
# The endpoint must support Chat Completions function/tool calling.
# MATERIAL_AGENT_BASE_URL=https://your-provider.example/v1
# MATERIAL_AGENT_MODEL=your-tool-capable-model
# MATERIAL_AGENT_API_KEY=your-api-key
